{
  "name": "opencode-storybook-agents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static",
    "evidence": "node scripts/capture-evidence.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "mermaid:check": "node scripts/validate-mermaid.mjs"
  },
  "dependencies": {
    "@storybook/blocks": "^8.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@vitejs/plugin-react": "^4.4.1",
    "mermaid": "^11.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.6.2",
    "storybook": "^8.6.14",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
